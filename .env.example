# Скопировать в .env и заполнить. .env в git не попадает.

# ── база ─────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://baza:CHANGE_ME@127.0.0.1:5432/baza

# ── доступ к дашборду и API ──────────────────────────────────────────────────
ADMIN_TOKEN=CHANGE_ME

# ── внешние сервисы ──────────────────────────────────────────────────────────
PARSERIM_KEY=
APIFY_TOKEN=
OPENROUTER_KEY=
# slug модели на OpenRouter; дешёвая — разметка и квалификация, умная — спорные случаи
AI_MODEL_CHEAP=anthropic/claude-haiku-4.5
AI_MODEL_SMART=anthropic/claude-sonnet-5

# ── пробив на старом сервере ────────────────────────────────────────────────
PROBE_BASE_URL=http://132.243.114.17
# токен приёма у задачи со сценарием instagram (вкладка Задачи → 🔗)
PROBE_HOOK_TOKEN=
# секрет, которым старый сервер подписывает обратный вызов к нам
PROBE_CALLBACK_SECRET=CHANGE_ME

# ── связь с CRM ─────────────────────────────────────────────────────────────
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=CHANGE_ME
# секрет, который CRM шлёт нам в X-Hook-Secret со статусами
INBOX_SECRET=CHANGE_ME

# ── оповещения ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# ── лимиты ──────────────────────────────────────────────────────────────────
APIFY_DAILY_CAP_USD=10
PARSERIM_MAX_PARALLEL_JOBS=3

# ── отображение ─────────────────────────────────────────────────────────────
TZ_DISPLAY=Europe/Moscow
