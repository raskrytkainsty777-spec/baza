# Всё текстовое — с LF, иначе скрипты и юниты уезжают на сервер с CRLF и не запускаются.
* text=auto eol=lf
*.sh       text eol=lf
*.service  text eol=lf
*.conf     text eol=lf
*.py       text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.md       text eol=lf
*.png binary
*.jpg binary
*.woff2 binary
